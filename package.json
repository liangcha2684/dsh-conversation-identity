{
  "name": "dsh-conversation-identity",
  "version": "0.1.1",
  "description": "对话身份延续：导入一段聊天记录，把「聊天的对面」重建成可注入的身份卡（语气 / 节奏 / 思维 / 相处方式），新建会话时选用即可无缝接着聊。支持平台导出、微信 CSV 与纯文本，三档强度，带回放盲判验收与原文检索。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "使用说明书.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "author": "liang-cha <1071445910@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liangcha2684/dsh-conversation-identity.git"
  },
  "homepage": "https://github.com/liangcha2684/dsh-conversation-identity#readme",
  "bugs": {
    "url": "https://github.com/liangcha2684/dsh-conversation-identity/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "identity",
    "persona",
    "chat-import"
  ],
  "scripts": {
    "test": "node --test"
  }
}
